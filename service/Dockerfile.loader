# Loads the catalogue's vector layers into PostGIS (scripts/load_postgis.py), then exits.
FROM python:3.12-slim
RUN pip install --no-cache-dir geopandas==1.2.0 pyarrow==26.0.1 shapely==2.2.0 pystac==1.16.0 \
        PyYAML==6.0.3 psycopg2-binary==2.9.13
WORKDIR /app
COPY catalogue catalogue
COPY scripts/common.py scripts/load_postgis.py scripts/
COPY docs/stac docs/stac
CMD ["python", "scripts/load_postgis.py"]
